{% template story_meta %}
  {%- assign secs = date | date: '%s' | plus: tz -%}
  {{- secs | date: '%-d %B' | upcase }} · {{ secs | date: '%H:%M' }}{% if single == false and source and source != '' %} · {{ source | upcase }}{% endif -%}
{% endtemplate %}

{% assign hf = stories[0] | split: '|||' %}
{% assign htitle = hf[1] | strip %}
{% assign himg = hf[2] | strip %}
{% assign hsum = hf[3] | strip %}
{% assign hsource = hf[4] | strip %}
{% assign hdate = hf[5] | strip %}

{%- assign hmeta = '' -%}
{%- if hdate != '' -%}
  {%- assign hsecs = hdate | date: '%s' | plus: trmnl.user.utc_offset -%}
  {%- capture hmeta -%}{{ hsecs | date: '%-d %B' | upcase }} · {{ hsecs | date: '%H:%M' }}{% if single_feed == false and hsource and hsource != '' %} · {{ hsource | upcase }}{% endif %}{%- endcapture -%}
{%- endif -%}

{% assign user_title = trmnl.plugin_settings.custom_fields_values.display_title %}
{% assign user_icon = trmnl.plugin_settings.custom_fields_values.icon_url %}
{% if single_feed %}
  {% assign feed_title = user_title | default: feed_title_src | default: trmnl.plugin_settings.instance_name %}
  {% assign icon_img = user_icon | default: feed_icon_src %}
{% else %}
  {% assign feed_title = user_title | default: trmnl.plugin_settings.instance_name %}
  {% assign icon_img = user_icon %}
{% endif %}

